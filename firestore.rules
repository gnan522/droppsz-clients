rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the shared team account (signed in with the code word) can see or change client data.
    function isTeam() {
      return request.auth != null
        && request.auth.token.email == "team@droppsz-clients.app";
    }
    match /clients/{clientId} {
      allow read, write: if isTeam();
    }
  }
}
