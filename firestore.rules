rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data lives under teams/<code word>/clients. Only the right code word opens it.
    // The live rules (in the Firebase console) hold a SHA-256 hash of the code word.
    // Generate it with: printf "yourword" | openssl dgst -sha256 -binary | base64
    function rightWord(code) {
      return hashing.sha256(code).toBase64() == "SHA256_OF_CODE_WORD_BASE64";
    }
    match /teams/{code}/clients/{clientId} {
      allow read, write: if request.auth != null && rightWord(code);
    }
  }
}
